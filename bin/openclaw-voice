#!/usr/bin/env python3
"""Control the native voice service through a private Unix socket."""
import json
import os
from pathlib import Path
import socket
import subprocess
import sys
import time

mode = sys.argv[1] if len(sys.argv) > 1 else 'toggle'
if mode == 'open':
    mode = 'toggle'
if mode not in {'toggle', 'stop', 'mute', 'status', 'preflight'}:
    raise SystemExit('Usage: openclaw-voice [toggle|stop|mute|status|preflight]')
runtime = os.environ.get('XDG_RUNTIME_DIR')
if not runtime:
    raise SystemExit('Run OpenClaw Voice inside your desktop session.')
path = str(Path(runtime) / 'openclaw-voice/control.sock')


def request(command):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.settimeout(32)
        client.connect(path)
        client.sendall((json.dumps({'command': command}) + '\n').encode())
        with client.makefile('rb') as response:
            data = json.loads(response.readline(65537))
        if not data.get('ok'):
            raise RuntimeError('Voice command failed.')
        return data


try:
    if mode == 'stop':
        # If control has failed, systemd still owns and can terminate all audio processes.
        try:
            result = request(mode)
        except (OSError, ValueError, RuntimeError):
            subprocess.run(['systemctl', '--user', 'stop', 'openclaw-voice.service'], check=True, timeout=25)
            # A manually started daemon may be outside systemd's control.
            # Do not claim its microphone is off without a control acknowledgment.
            raise RuntimeError('Stopped the systemd service; could not verify another daemon.')
    else:
        try:
            request('status')
        except (OSError, ValueError, RuntimeError):
            subprocess.run(['systemctl', '--user', 'start', 'openclaw-voice.service'], check=True, timeout=25)
        for attempt in range(40):
            try:
                status = request('status')
                if mode == 'status' or status['connected']:
                    break
            except (OSError, ValueError, RuntimeError):
                pass
            time.sleep(0.2)
        else:
            raise RuntimeError('Gateway unavailable.')
        result = status if mode == 'status' else request(mode)
    print(json.dumps(result))
except (OSError, ValueError, RuntimeError, subprocess.SubprocessError):
    if mode == 'toggle':
        # A timed-out start may have reached the daemon. Cancel it rather than
        # reporting failure while leaving a microphone running.
        subprocess.run(['systemctl', '--user', 'stop', 'openclaw-voice.service'], check=False)
    try:
        subprocess.run(['notify-send', 'OpenClaw Voice', 'Voice unavailable. Check the gateway and audio setup.'], check=False)
    except OSError:
        pass
    raise SystemExit('Voice command failed. Use openclaw-voice stop to end any remaining session.')
